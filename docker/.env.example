# Example environment file for docker compose builds.
# Copy to `.env` (same directory as the compose files) and adjust as needed.
# Docker compose automatically reads `.env` from the compose project directory
# and uses the values for ${VAR} interpolation in build args.
#
# Go module proxy used during image builds.
# Leave unset (or "direct") to fetch modules directly from source repositories.
# Users behind restrictive networks can point this at a mirror, e.g.:
#   GOPROXY=https://goproxy.cn,direct
GOPROXY=direct

# Alpine APK mirror used during image builds (agentry image only).
# Leave unset to use the default dl-cdn.alpinelinux.org, e.g.:
#   APK_MIRROR=mirrors.aliyun.com
APK_MIRROR=
